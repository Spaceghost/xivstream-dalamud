# xivstream: Wolf's NVIDIA driver volume (generated by xivstream)
[Unit]
Description=xivstream: NVIDIA driver volume for Wolf (rebuilt when the host driver changes)
After=network-online.target podman.socket
Wants=network-online.target
Before=wolf.service

[Service]
Type=oneshot
RemainAfterExit=yes
# A no-op when nvidia-driver-vol matches /sys/module/nvidia/version; a rebuild
# downloads NVIDIA's installer once per driver version.
ExecStart=/usr/local/bin/xivstream nvidia-driver-vol
TimeoutStartSec=1800
Nice=19
IOSchedulingClass=idle
