# xivstream: Wolf's network policy. (Generated by xivstream; loaded by
# xivstream-wolf-firewall.service while Wolf runs.)
#
# Wolf binds every IPv4 address with no option to choose one: its ports are
# for loopback and the tailnet clients only. The game's session sits on the
# xivstream0 bridge (10.89.10.0/24): it may reach the host only at the gateway's forwards,
# and never the tailnet or a private network; the internet stays open.
# Tailnet peers that reached the old Incus game container keep reaching
# the session at the same address.
table inet xivstream_wolf
delete table inet xivstream_wolf

table inet xivstream_wolf {
	set offlimits4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4 }
	}

	set wolf_clients {
		type ipv4_addr
		flags interval
		elements = { 100.83.231.2, 100.120.57.57, 100.64.131.52 }
	}

	set inbound_peers {
		type ipv4_addr
		flags interval
		elements = { 100.83.231.2, 100.104.232.33, 10.61.200.1 }
	}

	chain input {
		type filter hook input priority filter - 10; policy accept;
		# Wolf: loopback, and the allowed clients over Tailscale
		tcp dport { 47984, 47989, 48010 } iifname "lo" accept
		udp dport { 47999, 48100, 48200 } iifname "lo" accept
		tcp dport { 47984, 47989, 48010 } iifname "tailscale0" ip saddr @wolf_clients accept
		udp dport { 47999, 48100, 48200 } iifname "tailscale0" ip saddr @wolf_clients accept
		tcp dport { 47984, 47989, 48010 } counter drop
		udp dport { 47999, 48100, 48200 } counter drop
		# the session: replies, and the forwards on its gateway; nothing else here
		iifname "xivstream0" ct state established,related accept
		iifname "xivstream0" ip daddr 10.89.10.1 tcp dport { 4713, 7787, 7788, 7789, 8178, 41881 } accept
		iifname "xivstream0" counter drop
		# the forwards are the session's (and Wolf's PulseAudio's, for the microphone)
		ip daddr 10.89.10.1 tcp dport { 4713, 7787, 7788, 7789, 8178, 41881 } iifname != "lo" counter drop
	}

	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "xivstream0" ct state established,related accept
		iifname "xivstream0" meta nfproto ipv6 counter drop
		iifname "xivstream0" oifname "tailscale0" counter drop
		iifname "xivstream0" ip daddr @offlimits4 counter drop
		oifname "xivstream0" ct state established,related accept
		oifname "xivstream0" ip daddr 10.89.10.10 tcp dport { 41800, 41881, 7777 } ip saddr @inbound_peers accept
		oifname "xivstream0" counter drop
	}

	# The old game container's address (10.61.200.110, its subnet route and tailnet ACL
	# stay as they were) now leads to the session.
	chain prerouting {
		type nat hook prerouting priority dstnat - 10; policy accept;
		ip daddr 10.61.200.110 tcp dport { 41800, 41881, 7777 } ip saddr @inbound_peers dnat ip to 10.89.10.10
	}

	chain output {
		type nat hook output priority dstnat - 10; policy accept;
		ip daddr 10.61.200.110 tcp dport { 41800, 41881, 7777 } dnat ip to 10.89.10.10
	}
}
