# xivstream: Wolf, rootful. (Generated by xivstream; edit the config and
# re-run `xivstream apply` instead of this file.)
[Unit]
Description=Wolf game streaming server (xivstream)
Documentation=https://games-on-whales.github.io/wolf/stable/
Requires=podman.socket xivstream-wolf-firewall.service xivstream-nvidia-driver-vol.service
Wants=network-online.target
After=network-online.target tailscaled.service podman.socket xivstream-wolf-firewall.service xivstream-nvidia-driver-vol.service
# The game's home: never start on the bare mountpoint (an empty home would
# make XIVLauncher start a fresh install).
RequiresMountsFor=/var/lib/xivstream/home
# One streaming server at a time: starting either stops the other, and
# the Incus container is down before the preflight looks.
Conflicts=xivstream-sunshine.service
After=xivstream-sunshine.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Container]
ContainerName=wolf
HostName=wolf
Image=ghcr.io/games-on-whales/wolf@sha256:b0ef253739f9bd49b71eba7e150c955fd05990c0d409e666d89236995351551a
Network=host
SecurityLabelDisable=true
PodmanArgs=--ipc=host --device-cgroup-rule "c 13:* rmw"
AddDevice=/dev/dri
AddDevice=/dev/uinput
AddDevice=/dev/uhid
AddDevice=/dev/nvidia0
AddDevice=/dev/nvidiactl
AddDevice=/dev/nvidia-modeset
AddDevice=/dev/nvidia-uvm
AddDevice=-/dev/nvidia-uvm-tools
Volume=nvidia-driver-vol:/usr/nvidia:rw
Environment=NVIDIA_DRIVER_VOLUME_NAME=nvidia-driver-vol
Volume=/etc/wolf:/etc/wolf:rw
Volume=/run/podman/podman.sock:/var/run/docker.sock:rw
Volume=/dev:/dev:rw
Volume=/run/udev:/run/udev:rw
# Wolf's sockets (its API for `xivstream pair`, each session's Wayland and
# PulseAudio) on the host, where the session containers are given them.
Volume=/run/wolf:/run/user/wolf:rw
Environment=XDG_RUNTIME_DIR=/run/user/wolf
Environment=WOLF_SOCKET_PATH=/run/user/wolf/wolf.sock
Environment=WOLF_RENDER_NODE=/dev/dri/renderD129
Environment=WOLF_USE_ZERO_COPY=FALSE
Environment=WOLF_STOP_CONTAINER_ON_EXIT=TRUE

[Service]
# The first start pulls the image; stopping lets Wolf end its sessions.
TimeoutStartSec=900
TimeoutStopSec=60
# The device nodes the [Container] section requires (nvidia0 and
# nvidiactl; modeset; nvidia-uvm and -uvm-tools), whatever loaded so far.
# A failure here shows up as podman's missing device, with its name.
ExecStartPre=-/usr/bin/nvidia-modprobe -c0
ExecStartPre=-/usr/bin/nvidia-modprobe -m
ExecStartPre=-/usr/bin/nvidia-modprobe -u -c0
# Refuses while the Incus game container runs, checks the home, clears
# leftover session containers, and merges xivstream's app into Wolf's config.
ExecStartPre=/usr/local/bin/xivstream wolf-preflight
# Wolf removes a session's container only when the session ends normally.
ExecStopPost=-/usr/local/bin/xivstream wolf-cleanup
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
