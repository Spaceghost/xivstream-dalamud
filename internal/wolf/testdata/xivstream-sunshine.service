# xivstream: the Sunshine fallback (generated by xivstream)
#   systemctl start xivstream-sunshine.service   stops Wolf and starts the Incus game container
#   systemctl start wolf.service              switches back
# Log out of the game first either way: stopping a session gives the game
# seconds, not a clean exit.
[Unit]
Description=xivstream: Sunshine in the ffxiv Incus container (fallback for Wolf)
Conflicts=wolf.service
After=wolf.service xivstream-wolf-firewall.service incus.service tailscaled.service network-online.target
Wants=incus.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=XIVSTREAM_CONFIG=/etc/xivstream/sunshine.toml
# Wolf's session containers can outlive Wolf; never run two games on one home.
ExecStartPre=/usr/local/bin/xivstream wolf-cleanup
ExecStart=/usr/local/bin/xivstream start-container
ExecStop=/usr/local/bin/xivstream stop-container
TimeoutStartSec=600
TimeoutStopSec=150
