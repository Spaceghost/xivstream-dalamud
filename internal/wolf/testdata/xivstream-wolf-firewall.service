# xivstream: Wolf's network policy (generated by xivstream)
[Unit]
Description=xivstream: Wolf's firewall (tailnet-only Wolf ports, the session's network policy)
After=firewalld.service tailscaled.service
Before=wolf.service
PartOf=wolf.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/xivstream/wolf.nft
ExecStop=-/usr/sbin/nft delete table inet xivstream_wolf
