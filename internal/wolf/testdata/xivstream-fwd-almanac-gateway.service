# xivstream: the Wolf session's almanac-gateway forward (generated by xivstream)
[Unit]
Description=xivstream: relay almanac-gateway to 100.100.110.16:41881 for the Wolf session
Requires=xivstream-fwd-almanac-gateway.socket
After=xivstream-fwd-almanac-gateway.socket

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 100.100.110.16:41881
DynamicUser=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
