# xivstream: the game's home for the Wolf session (generated by xivstream)
[Unit]
Description=xivstream: the game's home (btrfs subvolume xivstream-home)

[Mount]
What=/dev/disk/by-uuid/1c289f95-5b61-4816-9b55-e161e424f3ff
Where=/var/lib/xivstream/home
Type=btrfs
Options=subvol=xivstream-home

[Install]
WantedBy=multi-user.target
